APP_ENV=development
GRPC_PORT=50051

# Data source driver: "postgres" (local pgx pool) or "grpc" (remote
# warehouse service, using WAREHOUSE_GRPC_TARGET). Defaults to postgres.
REPOSITORY_DRIVER=postgres

# Remote warehouse service address, used when REPOSITORY_DRIVER=grpc.
WAREHOUSE_GRPC_TARGET=localhost:50052

DATABASE_URL=postgres://warehouse:warehouse_password@localhost:5433/warehouse_db?sslmode=disable

REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# Per-RPC timeout for the grpc driver, in seconds.
GRPC_TIMEOUT_SECONDS=3
